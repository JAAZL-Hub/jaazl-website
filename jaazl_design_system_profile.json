    "doNotRules": {
      "gradients": [
        "DO NOT apply card background gradients to icons",
        "DO NOT use button gradients on text elements", 
        "DO NOT apply hero background gradients to small components",
        "DO NOT use service card gradients on navigation elements",
        "DO NOT mix blue and orange gradients in unexpected places"
      ],
      "colors": [
        "DO NOT use primary button colors for body text",
        "DO NOT apply icon colors to card backgrounds",
        "DO NOT use accent colors for large background areas",
        "DO NOT mix warm and cool gradients in the same component"
      ],
      "effects": [
        "DO NOT apply card shadows to icons",
        "DO NOT use backdrop blur on non-overlay elements",
        "DO NOT apply hover transforms to static text",
        "DO NOT use large border radius on small elements"
      ],
      "typography": [
        "DO NOT use heading font weights for body text",
        "DO NOT apply gradient text to navigation links",
        "DO NOT use white text on light backgrounds",
        "DO NOT apply text transforms to technical specifications"
      ]
    },

    "implementationGuidelines": {
      "priority": [
